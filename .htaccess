<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ----------------------------------------------------------------------
  # 1. Force HTTPS and canonical domain (redirect www to non-www)
  # ----------------------------------------------------------------------
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\.medhavat\.com$ [NC]
  RewriteRule ^(.*)$ https://medhavat.com/$1 [L,R=301]

  # ----------------------------------------------------------------------
  # 2. Redirect /index.html and /index to root /
  # ----------------------------------------------------------------------
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/index(\.html)? [NC]
  RewriteRule ^index(\.html)?$ / [R=301,L]

  # ----------------------------------------------------------------------
  # 3. External 301 redirect: strip .html extension in browser
  #    (e.g., https://medhavat.com/services.html -> https://medhavat.com/services)
  # ----------------------------------------------------------------------
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.+?)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # ----------------------------------------------------------------------
  # 4. Internal rewrite: resolve clean URL to the underlying .html file
  #    (e.g., request for /services silently serves services.html)
  # ----------------------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^([^\.]+)$ $1.html [NC,L]

</IfModule>

# ----------------------------------------------------------------------
# 5. Security & MIME types
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ----------------------------------------------------------------------
# 6. Browser Caching
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
